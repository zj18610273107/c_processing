{
  "name": "c-preprocessor-visualizer",
  "displayName": "C Preprocessor Visualizer",
  "description": "Highlights matching C preprocessor branches and dims inactive code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:objective-c",
    "onLanguage:objective-cpp",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "parser.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --check extension.js && node --check parser.js && node c-preprocessor-visualizer-tests/c-preprocessor-visualizer.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "configuration": {
      "title": "C Preprocessor Visualizer",
      "properties": {
        "cPreprocessorVisualizer.inactiveColor": {
          "type": "string",
          "default": "#5ac83cd9",
          "description": "Text color used for inactive preprocessor regions."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
